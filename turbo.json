{
  "$schema": "https://turborepo.com/schema.json",
  "boundaries": {
    "tags": {
      "app": { "dependencies": { "allow": ["app", "library"] } },
      "library": { "dependencies": { "allow": ["library"] } }
    }
  },
  "tasks": {
    "//#boundaries": { "cache": false },
    "//#check:generated": { "outputs": [] },
    "//#format:check": { "outputs": [] },
    "//#format:write": { "dependsOn": ["//#lint:fix"], "cache": false },
    "//#lint": { "outputs": [] },
    "//#lint:fix": { "cache": false },
    "//#rust:check": { "cache": false, "outputs": [] },
    "//#test": {
      "dependsOn": [
        "@enoki/api-client#test",
        "@enoki/hub#test",
        "@enoki/proto#test",
        "@enoki/web#test"
      ],
      "outputs": []
    },
    "//#test:e2e": {
      "dependsOn": ["^build", "//#test"],
      "cache": false
    },
    "//#typecheck": { "outputs": [] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check:generated": { "outputs": [] },
    "format:check": { "outputs": [] },
    "format:write": { "dependsOn": ["lint:fix"], "cache": false },
    "lint": { "outputs": [] },
    "lint:fix": { "cache": false },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    }
  }
}
