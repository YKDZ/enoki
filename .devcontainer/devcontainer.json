{
  "name": "Enoki",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "NODE_VERSION": "24",
      "PACKAGE_MANAGER_PIN": "pnpm@11.11.0",
      "PLAYWRIGHT_CLI_PACKAGE": "@playwright/test@1.61.1",
      "RUST_TOOLCHAIN": "stable"
    }
  },
  "runArgs": [
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--cap-add=SYS_ADMIN"
  ],
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {
      "moby": true,
      "installDockerBuildx": true,
      "installDockerComposeSwitch": true,
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "redhat.vscode-yaml",
        "fill-labs.dependi",
        "oxc.oxc-vscode",
        "Selemondev.shadcn-vue",
        "Vue.volar"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.features": "all",
        "rust-analyzer.procMacro.enable": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml"
        }
      }
    }
  },
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "RUST_BACKTRACE": "1"
  },
  "postCreateCommand": {
    "installNodeDependencies": "pnpm install",
    "prefetchRustDependencies": "cargo fetch",
    "installPlaywrightBrowser": "pnpm exec playwright install chromium"
  },
  "remoteUser": "root",
  "mounts": [
    "source=${localWorkspaceFolderBasename}-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=${localWorkspaceFolderBasename}-cargo-git,target=/usr/local/cargo/git,type=volume",
    "source=${localWorkspaceFolderBasename}-target,target=${containerWorkspaceFolder}/target,type=volume"
  ]
}
