{
  "name": "@enoki/hub",
  "private": true,
  "bin": {
    "enoki-hub-state": "dist/src/hub-state-snapshot/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "pnpm run db:generate:core && pnpm run db:generate:official-metrics",
    "db:generate:core": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:official-metrics": "drizzle-kit generate --config drizzle.official-metrics.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts && drizzle-kit push --config drizzle.official-metrics.config.ts",
    "start": "node dist/src/server.js",
    "test": "turbo run build --filter=@enoki/hub && pnpm run test:built",
    "test:built": "vitest run --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@enoki/api-client": "workspace:*",
    "@enoki/proto": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/node-ws": "^1.3.1",
    "@hono/valibot-validator": "^0.6.1",
    "drizzle-orm": "1.0.0-beta.22",
    "hono": "catalog:",
    "valibot": "catalog:",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@enoki/probe-release": "workspace:*",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "1.0.0-beta.22",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "turbo": {
    "tags": [
      "app"
    ]
  }
}
