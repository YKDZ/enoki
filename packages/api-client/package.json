{
  "name": "@enoki/api-client",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "development": "./src/protocol.ts",
      "import": "./dist/protocol.js"
    },
    "./probe-configuration": {
      "types": "./src/probe-configuration.ts",
      "development": "./src/probe-configuration.ts",
      "import": "./dist/probe-configuration.js"
    },
    "./websocket": {
      "types": "./src/websocket.ts",
      "development": "./src/websocket.ts",
      "import": "./dist/websocket.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@enoki/proto": "workspace:*",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
